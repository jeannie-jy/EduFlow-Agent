{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduflow.local/schemas/eduflowbench-case-v1.json",
  "title": "EduFlowBench Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "domain", "difficulty", "topic", "expected"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "version": { "type": "string", "default": "1.0" },
    "domain": {
      "enum": [
        "algorithm",
        "data_structure",
        "operating_system",
        "network",
        "database",
        "software_engineering",
        "custom"
      ]
    },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "topic": { "type": "string", "minLength": 2, "maxLength": 500 },
    "constraints": { "type": "object", "default": {} },
    "materials": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_concepts", "forbidden_claims", "min_frames", "max_frames"],
      "properties": {
        "required_concepts": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } },
        "forbidden_claim_scopes": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subjects"],
            "properties": {
              "subjects": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "allowed_subjects": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              }
            }
          }
        },
        "min_frames": { "type": "integer", "minimum": 0 },
        "max_frames": { "type": "integer", "minimum": 1 },
        "final_state": { "type": "object", "default": {} }
      }
    },
    "oracle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["sorted_array", "final_state"] },
            "input": { "type": "object", "default": {} },
            "expected": {}
          }
        }
      ]
    },
    "retrieval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relevant_document_ids"],
          "properties": {
            "relevant_document_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
            "must_abstain_without_evidence": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
