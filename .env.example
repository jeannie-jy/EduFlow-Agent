# EduFlow-Agent 环境变量模板
# 复制为 .env：cp .env.example .env

# ── LLM ──────────────────────────────────────────────────
# 主模型：DeepSeek API (兼容 OpenAI 接口)
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key

# 嵌入模型：OpenAI API
EMBEDDING_ENDPOINT=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_DIMENSION=1536
# 通义千问 Embedding 平替 OpenAI （百炼搜索 text-embedding-v4）
# EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=your-dashscope-api-key
# EMBEDDING_DIMENSION=1536


# 备用模型 (复杂推理场景，可选)
# LLM_BACKUP_ENDPOINT=https://api.anthropic.com/v1
# LLM_BACKUP_MODEL=claude-sonnet-5-20251001
# LLM_BACKUP_API_KEY=your-anthropic-api-key

# ── 数据库 ───────────────────────────────────────────────
DB_PASSWORD=changeme
DATABASE_URL=postgresql://agent:changeme@localhost:5432/eduflow

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Agent ────────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO

# ── 对象存储 (MinIO) ────────────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ── 可观测性（可选）──────────────────────────────────────
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=eduflow-agent

# ── 前端 ──────────────────────────────────────────────────
# 开发时后端地址（Vite 代理目标）
VITE_API_BASE_URL=http://localhost:8000/api
