# EduFlow-Agent 环境变量模板
# 复制为 .env：cp .env.example .env
# 变量清单与 agent/config.py 的 Settings 字段一一对应（config.py 是唯一真源）

# ── 应用 ──────────────────────────────────────────────────
LOG_LEVEL=INFO            # text | json
LOG_FORMAT=text

# ── LLM ──────────────────────────────────────────────────
# 主模型：DeepSeek API (兼容 OpenAI 接口)
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-deepseek-api-key
LLM_TIMEOUT_SECONDS=120
LLM_GATEWAY_MAX_RETRIES=2
LLM_GATEWAY_RETRY_BASE_SECONDS=0.5
LLM_GATEWAY_MAX_CONCURRENCY=8
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30
# 按供应商价目填写每百万 Token 美元价格；0 表示只统计 Token、不估算费用
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_REQUEST_MAX_TOKENS=200000
LLM_REQUEST_MAX_COST_USD=10
# 可选：不同节点路由到同一供应商的不同模型；留空继承 LLM_MODEL
LLM_PLANNER_MODEL=
LLM_KNOWLEDGE_MODEL=
LLM_CODER_MODEL=
LLM_QUALITY_MODEL=
LLM_REFLECTION_MODEL=
LLM_MODULE_MODEL=
LLM_MANIM_MODEL=
# 可选：主供应商在网关重试耗尽或熔断时切换到备用 OpenAI-compatible 端点
LLM_BACKUP_ENDPOINT=
LLM_BACKUP_MODEL=
LLM_BACKUP_API_KEY=

# 嵌入模型：OpenAI-compatible endpoint（当前默认使用 1024 维）
EMBEDDING_ENDPOINT=https://your-openai-compatible-endpoint/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_DIMENSION=1024
# OpenAI text-embedding-3-small 的替代配置（必须同时改回数据库迁移维度）
# EMBEDDING_ENDPOINT=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-openai-api-key
# EMBEDDING_DIMENSION=1536

# ── 数据库 ───────────────────────────────────────────────
# 也可拆分为 DB_USER / DB_HOST / DB_PORT / DB_NAME（见 config.py）
DB_USER=agent
DB_PASSWORD=replace-with-a-long-random-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduflow
# 完整 URL 优先于拆分字段；postgresql:// 会被自动修正为 +asyncpg://
# 若密码包含 URL 保留字符，需要先进行 percent-encoding
DATABASE_URL=postgresql+asyncpg://agent:replace-with-a-long-random-password@localhost:5432/eduflow

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 知识库 ───────────────────────────────────────────────
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.7
RETRIEVAL_QUERY_COUNT=3
RETRIEVAL_CONTEXT_MAX_CHARS=6000

# ── Agent ────────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_MS=120000
# 质量-修订循环：低于该分数或 is_blocking 时触发 Reflection
QUALITY_SCORE_THRESHOLD=0.6
# 修订循环上限，0 = 不修订（开发时加速迭代），生产建议 3
MAX_REFLECTION_CYCLES=3
MAX_REPLAN_CYCLES=3
MODULE_GENERATION_CONCURRENCY=3
TOOL_CALLING_ENABLED=true
TOOL_MAX_ROUNDS=3
TOOL_MAX_CALLS=8
TOOL_MAX_CONCURRENCY=3
TOOL_TIMEOUT_SECONDS=10
TOOL_RESULT_MAX_CHARS=12000
SSE_STREAM_LEASE_SECONDS=90
SSE_STREAM_POLL_SECONDS=0.5
SSE_EVENT_RETENTION_HOURS=24

# ── 文件上传 ─────────────────────────────────────────────
UPLOAD_DIR=data/uploads
UPLOAD_MAX_SIZE_BYTES=52428800
MATERIAL_RETENTION_DAYS=30
MATERIAL_CLEANUP_INTERVAL_SECONDS=21600

# ── 视频导出 ──────────────────────────────────────────────
EXPORT_DIR=data/exports
MANIM_TIMEOUT_SECONDS=600
EXPORT_WORKER_HEARTBEAT_SECONDS=30
EXPORT_WORKER_MAX_ATTEMPTS=3
EXPORT_RETRY_BASE_SECONDS=5
EXPORT_RETRY_MAX_SECONDS=300
EXPORT_MAX_WORKSPACE_BYTES=1073741824
EXPORT_MAX_WORKSPACE_FILES=5000

# ── 通用后台任务（Feedback Reflection 等）─────────────────
TASK_WORKER_POLL_SECONDS=2
TASK_WORKER_HEARTBEAT_SECONDS=30
TASK_WORKER_LEASE_SECONDS=300
TASK_WORKER_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=300
# FFmpeg 安装目录（留空则自动从 PATH 查找）
# Windows 示例 (winget): %LOCALAPPDATA%\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-*-full_build\bin
# FFMPEG_PATH=

# ── 预留：尚未接入代码 ─────────────────────────────────────
# 可观测性（可选）——config.py 尚无对应字段，接入后再启用
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=eduflow-agent

# 对象存储（Compose 中用于持久化导出产物和上传素材）
MINIO_USER=replace-with-a-random-access-key
MINIO_PASSWORD=replace-with-a-long-random-secret-key
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ── 前端 ──────────────────────────────────────────────────
# 后端 API 基地址（直接作为 fetch 基址使用，非 Vite 代理目标；
# 开发模式也可留空走 /api 相对路径 + vite.config.ts 的 /api 代理）
VITE_API_BASE_URL=http://localhost:8000/api
# 视频导出默认关闭；仅配合 `docker compose --profile video up` 设为 queue
MANIM_EXECUTION_MODE=disabled
# deterministic：直接将受控 DSL 编译为 Manim（默认、快速、无额外 LLM 调用）
# llm：先生成创意脚本，失败时自动降级到 deterministic
MANIM_SCRIPT_MODE=deterministic
MATERIAL_PARSE_TIMEOUT_SECONDS=120
MATERIAL_PARSE_RESULT_MAX_BYTES=2097152

# Compose 默认要求真实后端会话；本机 HTTP 调试保持 Secure=false，HTTPS 部署必须设 true
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=false
AUDIT_RETENTION_DAYS=90
# Required only when running signed audit archive/purge; use at least 32 random characters.
AUDIT_ARCHIVE_HMAC_KEY=
API_WRITE_RATE_LIMIT=120
API_WRITE_RATE_WINDOW_SECONDS=60
API_GENERATION_RATE_LIMIT=20
API_GENERATION_RATE_WINDOW_SECONDS=300

# 可选 observability profile（Grafana 仅绑定本机端口）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
