# EduFlow-Agent 环境变量模板
# 复制为 .env：cp .env.example .env
# 变量清单与 agent/config.py 的 Settings 字段一一对应（config.py 是唯一真源）

# ── 应用 ──────────────────────────────────────────────────
LOG_LEVEL=INFO            # text | json
LOG_FORMAT=text

# ── LLM ──────────────────────────────────────────────────
# 主模型：DeepSeek API (兼容 OpenAI 接口)
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key

# 嵌入模型：OpenAI API
EMBEDDING_ENDPOINT=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_DIMENSION=1536
# 通义千问 Embedding 平替 OpenAI （百炼搜索 text-embedding-v4）
# EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=your-dashscope-api-key
# EMBEDDING_DIMENSION=1536

# ── 数据库 ───────────────────────────────────────────────
# 也可拆分为 DB_USER / DB_HOST / DB_PORT / DB_NAME（见 config.py）
DB_USER=agent
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduflow
# 完整 URL 优先于拆分字段；postgresql:// 会被自动修正为 +asyncpg://
DATABASE_URL=postgresql+asyncpg://agent:changeme@localhost:5432/eduflow

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 知识库 ───────────────────────────────────────────────
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.7

# ── Agent ────────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_MS=120000
# 质量-修订循环：低于该分数或 is_blocking 时触发 Reflection
QUALITY_SCORE_THRESHOLD=0.6
# 修订循环上限，0 = 不修订（开发时加速迭代），生产建议 3
MAX_REFLECTION_CYCLES=3

# ── 文件上传 ─────────────────────────────────────────────
UPLOAD_DIR=data/uploads
UPLOAD_MAX_SIZE_BYTES=52428800

# ── 视频导出 ──────────────────────────────────────────────
EXPORT_DIR=data/exports
MANIM_TIMEOUT_SECONDS=600
# FFmpeg 安装目录（留空则自动从 PATH 查找）
# Windows 示例 (winget): %LOCALAPPDATA%\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-*-full_build\bin
# FFMPEG_PATH=

# ── 预留：尚未接入代码 ─────────────────────────────────────
# 备用模型（复杂推理场景，可选）——config.py 尚无对应字段，接入后再启用
# LLM_BACKUP_ENDPOINT=https://api.anthropic.com/v1
# LLM_BACKUP_MODEL=claude-sonnet-5-20251001
# LLM_BACKUP_API_KEY=your-anthropic-api-key

# 可观测性（可选）——config.py 尚无对应字段，接入后再启用
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=eduflow-agent

# 对象存储 (MinIO) ——后端尚未接入 S3 客户端，仅 docker-compose 使用
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ── 前端 ──────────────────────────────────────────────────
# 后端 API 基地址（直接作为 fetch 基址使用，非 Vite 代理目标；
# 开发模式也可留空走 /api 相对路径 + vite.config.ts 的 /api 代理）
VITE_API_BASE_URL=http://localhost:8000/api
