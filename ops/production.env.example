# This is a deployment contract, not a secret file. Resolve secret-valued fields
# from the cloud secret manager and never commit a populated copy.
ENVIRONMENT=production
PUBLIC_ORIGIN=https://eduflow.example.com
ENFORCE_ORIGIN_CHECK=true
TRUSTED_PROXY_IPS=10.0.0.0/8
EXPOSE_API_DOCS=false
METRICS_ACCESS_TOKEN=secret-manager://eduflow/metrics-access-token
RUN_MAINTENANCE=false
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_REGISTRATION=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_REGISTRATION_CHALLENGE_REQUIRED=true
AUTH_REGISTRATION_CHALLENGE_SECRET=secret-manager://eduflow/registration-challenge
AUTH_REGISTRATION_CHALLENGE_DIFFICULTY=3
AUTH_TOKEN_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=secret-manager://eduflow/smtp-username
SMTP_PASSWORD=secret-manager://eduflow/smtp-password
SMTP_FROM=no-reply@eduflow.example.com
SMTP_STARTTLS=true
BYOK_REQUIRED=true
VIDEO_PUBLIC_ENABLED=false
CREDENTIAL_KMS_BACKEND=http
CREDENTIAL_KMS_WRAP_URL=https://kms-bridge.internal/v1/wrap
CREDENTIAL_KMS_UNWRAP_URL=https://kms-bridge.internal/v1/unwrap
CREDENTIAL_KMS_BEARER_TOKEN=secret-manager://eduflow/kms-bridge-token
CREDENTIAL_FINGERPRINT_KEY_B64=secret-manager://eduflow/credential-fingerprint-key
CREDENTIAL_KEK_VERSION=kms-key-version
OTEL_ENABLED=true
OTEL_SERVICE_NAME=eduflow-agent
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal
OTEL_EXPORTER_OTLP_HEADERS=authorization=secret-manager://eduflow/otel-token
OTEL_TRACE_SAMPLE_RATIO=0.1
DATABASE_URL=secret-manager://eduflow/database-url
REDIS_URL=secret-manager://eduflow/redis-url
MINIO_ACCESS_KEY=secret-manager://eduflow/object-access-key
MINIO_SECRET_KEY=secret-manager://eduflow/object-secret-key
LLM_API_KEY=
EMBEDDING_API_KEY=
