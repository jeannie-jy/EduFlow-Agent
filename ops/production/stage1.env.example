# Copy to a root-owned file outside the repository, for example
# /etc/eduflow/production.env (chmod 600). Never commit the populated file.

# Immutable images produced by .github/workflows/release-images.yml
AGENT_IMAGE=ghcr.io/your-org/eduflow-agent/agent@sha256:replace-me
WEB_IMAGE=ghcr.io/your-org/eduflow-agent/web@sha256:replace-me

# Host ingress. Keep loopback when a host reverse proxy terminates TLS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
API_PORT=8000
PUBLIC_ORIGIN=https://app.example.com
# The host reaches the published API port through the Compose bridge. Keep this
# CIDR aligned with COMPOSE_NETWORK_CIDR and do not broaden it.
COMPOSE_NETWORK_CIDR=172.31.240.0/24
TRUSTED_PROXY_IPS=172.31.240.0/24

# Managed PostgreSQL and Redis. Require TLS in provider-specific connection URLs.
DATABASE_URL=postgresql+asyncpg://app:replace-me@db.internal:5432/eduflow?ssl=require
REDIS_URL=rediss://default:replace-me@redis.internal:6379/0

# S3-compatible object storage. Endpoints must not include a URL path.
MINIO_ENDPOINT=objects.internal.example.com:443
MINIO_PUBLIC_ENDPOINT=assets.example.com:443
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=eduflow-artifacts
MINIO_SECURE=true

# Merge-only placeholders required while parsing the base Compose file. The
# corresponding local-infra services are profile-gated and are not started.
DB_PASSWORD=disabled-local-postgres
MINIO_USER=disabled-local-minio
MINIO_PASSWORD=disabled-local-minio-password

# Registration starts closed for canary verification.
AUTH_ALLOW_REGISTRATION=false
AUTH_REGISTRATION_CHALLENGE_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# BYOK envelope encryption through an internal HTTPS bridge.
CREDENTIAL_KMS_WRAP_URL=https://kms-bridge.internal/v1/wrap
CREDENTIAL_KMS_UNWRAP_URL=https://kms-bridge.internal/v1/unwrap
CREDENTIAL_KMS_BEARER_TOKEN=replace-me
CREDENTIAL_FINGERPRINT_KEY_B64=replace-with-base64-of-at-least-32-random-bytes
CREDENTIAL_KEK_VERSION=replace-with-kms-key-version

# Independent operational secrets.
METRICS_ACCESS_TOKEN=replace-me
AUDIT_ARCHIVE_HMAC_KEY=replace-with-at-least-32-random-characters

# Optional OTLP/HTTP exporter. Keep false until a collector is reachable.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=0.1
